<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="McpttField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:backgroundTint">@color/ops_border</item>
        <item name="android:textColor">@color/ops_text</item>
        <item name="android:textColorHint">@color/ops_text_dim</item>
    </style>

    <style name="McpttSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/ops_text_dim</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
