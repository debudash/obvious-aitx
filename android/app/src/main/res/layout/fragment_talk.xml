<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ops_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/affiliations"
            android:textColor="@color/ops_text_dim"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/groups_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/call_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_call_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/call_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ops_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/call_speaker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/ops_text_dim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_end_call"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/ops_denied"
                    android:text="@string/btn_end"
                    android:textColor="@color/ops_text" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/ptt_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/ptt_ready"
            android:textColor="@color/ops_text"
            android:textSize="15sp" />

        <Button
            android:id="@+id/ptt_button"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_ptt_button"
            android:backgroundTint="@color/ops_surface_higher"
            android:text="@string/ptt_ready"
            android:textColor="@color/ops_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/queue_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/ops_queue"
            android:visibility="gone" />

        <Button
            android:id="@+id/emergency_button"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_emergency_zone"
            android:backgroundTint="@color/ops_emergency"
            android:text="@string/emergency_hold"
            android:textColor="@color/ops_text"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
